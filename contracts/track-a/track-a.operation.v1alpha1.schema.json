{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcn.ssu.ac.kr/contracts/track-a.operation.v1alpha1.schema.json",
  "title": "Track A Operation v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "id", "project_id", "region_id", "action",
    "target_type", "target_id", "fingerprint", "idempotency_key", "state",
    "progress", "current_step", "error", "correlation_id", "created_at",
    "updated_at", "lease_owner", "lease_expires_at", "attempt",
    "next_attempt_at", "checkpoint", "request", "revision"
  ],
  "properties": {
    "contract_version": {"const": "track-a.operation.v1alpha1"},
    "id": {"type": "string", "format": "uuid", "description": "Platform Operation UUID."},
    "project_id": {"type": "string", "format": "uuid", "description": "Keystone project UUID that owns the Operation."},
    "region_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target_type": {"type": "string", "minLength": 1},
    "target_id": {"type": ["string", "null"], "format": "uuid"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "state": {"type": "string", "enum": ["REQUESTED", "VALIDATING", "SCHEDULED", "RUNNING", "ROLLING_BACK", "SUCCEEDED", "FAILED", "CANCELLED"]},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "current_step": {"type": ["string", "null"]},
    "error": {"type": ["object", "null"]},
    "correlation_id": {"type": "string", "format": "uuid", "description": "Stable UUID used to correlate API, worker and provider logs."},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lease_owner": {"type": ["string", "null"]},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "attempt": {"type": "integer", "minimum": 0},
    "next_attempt_at": {"type": ["string", "null"], "format": "date-time"},
    "checkpoint": {"type": ["object", "null"]},
    "request": {"type": "object"},
    "revision": {"type": "integer", "minimum": 0, "description": "Optimistic concurrency revision."}
  }
}
