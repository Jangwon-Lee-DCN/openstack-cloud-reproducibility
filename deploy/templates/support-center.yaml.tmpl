apiVersion: v1
kind: ServiceAccount
metadata:
  name: dcn-support-api
  namespace: @NAMESPACE@
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: dcn-support-data
  namespace: @NAMESPACE@
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 20Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dcn-support-api
  namespace: @NAMESPACE@
  labels: {application: dcn-support-api, component: api}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {application: dcn-support-api, component: api}
  template:
    metadata:
      labels: {application: dcn-support-api, component: api}
    spec:
      serviceAccountName: dcn-support-api
      imagePullSecrets: [{name: telemetry-harbor-push}]
      securityContext:
        runAsNonRoot: true
        fsGroup: 65532
      containers:
        - name: api
          image: @IMAGE@
          env:
            - name: SUPPORT_DATABASE_URL
              value: sqlite:////var/lib/dcn-support/support.db
            - name: SUPPORT_KEYSTONE_URL
              value: @KEYSTONE_URL@
          ports: [{name: http, containerPort: 8080}]
          securityContext:
            runAsUser: 65532
            runAsGroup: 65532
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {cpu: 1, memory: 512Mi}
          readinessProbe:
            httpGet: {path: /readyz, port: http}
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /healthz, port: http}
            initialDelaySeconds: 10
            periodSeconds: 20
          volumeMounts:
            - {name: data, mountPath: /var/lib/dcn-support}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: dcn-support-data}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: dcn-support-api
  namespace: @NAMESPACE@
spec:
  selector: {application: dcn-support-api, component: api}
  ports: [{name: http, port: 8080, targetPort: http}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: dcn-support-api-ingress
  namespace: @NAMESPACE@
spec:
  podSelector:
    matchLabels: {application: dcn-support-api, component: api}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: @HORIZON_NAMESPACE@
          podSelector:
            matchLabels:
              application: horizon
              component: server
      ports: [{protocol: TCP, port: 8080}]
