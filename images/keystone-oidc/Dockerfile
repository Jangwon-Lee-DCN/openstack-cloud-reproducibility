FROM quay.io/airshipit/keystone@sha256:3dcc27ea83169118e014a100c848f147279c5c8a0709c0c62d8c4766f0219e03

USER root

RUN printf '%s' '' | base64 -d > /usr/local/share/ca-certificates/openstack-public-ca.crt


RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libapache2-mod-auth-openidc \
 && update-ca-certificates \
 && openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt /usr/local/share/ca-certificates/openstack-public-ca.crt \
 && rm -rf /var/lib/apt/lists/*

USER 42424:42424

