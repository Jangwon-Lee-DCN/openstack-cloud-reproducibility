global
  log /dev/log local0
  daemon
  maxconn 4096

defaults
  log global
  mode tcp
  timeout connect 5s
  timeout client 50s
  timeout server 50s

frontend kubernetes_api
  bind *:{{ kubernetes_api_port }}
  default_backend kubernetes_api_nodes

backend kubernetes_api_nodes
  option tcp-check
  balance roundrobin
{% for node in groups['control_plane'] %}
  server {{ node }} {{ hostvars[node].ansible_host }}:6443 check
{% endfor %}
